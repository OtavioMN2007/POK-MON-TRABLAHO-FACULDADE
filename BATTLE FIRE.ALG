escreval("               **++++++++++++************************#####             ")
escreval("                 +********************************#####                ")
escreval("                     **************************#####                   ")
escreval("                          ******************###                        ")
escreval("")
            escreval("  * PARABENS! Voce capturou ", nome_inimigo, "! *")
            escreval("  ", nome_inimigo, " foi adicionado a sua Pokedex!")
            escreval("")
            escreval("************************************************************")
            escreval("*   VOCE E UM MESTRE POKEMON! Dois Pokemon capturados!     *")
            escreval("************************************************************")

         senao
            se (hp_inimigo <= 0) entao
               escreval("  ", nome_inimigo, " desmaiou!")
               escreval("  Vaporeon venceu! Voce e um otimo treinador!")
               escreval("")
               escreval("************************************************************")
               escreval("*         PARABENS! Sua jornada continua, Treinador!       *")
               escreval("************************************************************")
            senao
               escreval("  ", nome_jogador, " desmaiou...")
               escreval("  Voce foi derrotado na segunda batalha.")
               escreval("")
               escreval("************************************************************")
               escreval("*                      GAME  OVER                          *")
               escreval("*          Treine mais e tente novamente!                  *")
               escreval("************************************************************")
            fimse
         fimse

      fimse
   fimse

   escreval("")
   escreval("************************************************************")
   escreval("*            Obrigado por jogar Pokemon Battle!            *")
   escreval("************************************************************")

fimalgoritmo