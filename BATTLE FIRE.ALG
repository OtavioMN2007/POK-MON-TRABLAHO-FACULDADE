                      algoritmo "BatalhaPokeFireRed"
var
   nome_inimigo  : caractere
   nome_jogador  : caractere
   hp_inimigo    : inteiro
   hp_jogador    : inteiro
   capturado     : logico
   opcao         : inteiro
   dano          : inteiro
   tentativa     : inteiro

inicio

   // TELA DE BOAS-VINDAS

   limpatela
   escreval("**********************************************************************")
   escreval("*                                                                    *")
   escreval("*                     BEM-VINDO AO MUNDO DOS POKEMON!                *")
