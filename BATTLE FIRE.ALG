     escreval("            Pressione ENTER para entrar na batalha...")
   leia(opcao)
   limpatela


   // BATALHA 1 - PIKACHU vs EEVEE

   nome_inimigo <- "Eevee"
   nome_jogador <- "Pikachu"
   hp_inimigo   <- 20
   hp_jogador   <- 25
   capturado    <- falso

   escreval("************************************************************")
   escreval("*               BATALHA 1 - ZONA SELVAGEM                  *")
   escreval("************************************************************")
   escreval("")
   escreval("   Um ", nome_inimigo, " selvagem apareceu!")

