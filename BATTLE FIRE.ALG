escreval("##***##############*********#*****************%#***************************************************************************************")
escreval("***************#*######******#####***********####**************************************************************************************")
escreval("################*#######**#############*****###**##########**##************************************************************************")
escreval("##########*###########***#######******##********####*##############*#############******************************###########*************")
escreval("#############**#########***%######%##*******#%###*###############*##**###########################**************************************")
escreval("####**###################%#**********#****###############***###########**#######################***************************************")
escreval("########%##############%%%%%###################################################%#######################################################")

      escreval("")
      escreval("  [ ", nome_inimigo, " ]  HP: ", hp_inimigo)
      escreval("  [ ", nome_jogador, " ]  HP: ", hp_jogador)
      escreval("")
      escreval("----------------------------------------------------------")
      escreval("  O que ", nome_jogador, " vai fazer?")
      escreval("")
      escreval("  1 - ATACAR   (Choque do Trovao)")
      escreval("  2 - CAPTURAR (Jogar Pokebola)")
      escreval("----------------------------------------------------------")
      leia(opcao)
      limpatela

      escolha opcao
         caso 1
            dano <- randi(5) + 2
            hp_inimigo <- hp_inimigo - dano
            escreval(">>> ", nome_jogador, " usou CHOQUE DO TROVAO!")
            escreval("    Causou ", dano, " de dano!")

         caso 2
            escreval(">>> Voce jogou uma Pokebola!")
            tentativa <- randi(10) + 1
            se (tentativa > (hp_inimigo / 3)) entao
               escreval("    Clic!  1...  2...  3...")
               escreval("    Gotcha! ", nome_inimigo, " foi capturado!")
               capturado <- verdadeiro
            senao
               escreval("    Ah nao! ", nome_inimigo, " escapou da Pokebola!")
            fimse

         outrocaso
            escreval(">>> Opcao invalida! Voce perdeu o turno.")
      fimescolha

      se (hp_inimigo > 0) e (capturado = falso) entao
         escreval("")
         escreval("----------------------------------------------------------")
         dano <- randi(4) + 1
         hp_jogador <- hp_jogador - dano
         escreval(">>> O ", nome_inimigo, " usou ATAQUE RAPIDO!")
         escreval("    Causou ", dano, " de dano em ", nome_jogador, "!")
         escreval("----------------------------------------------------------")
      fimse

   fimenquanto

   /
   // RESULTADO DA BATALHA 1

   escreval("")
   escreval("************************************************************")
   escreval("*                  FIM DE BATALHA 1!                       *")
   escreval("************************************************************")
   escreval("")

   se (hp_jogador <= 0) entao
      // DERROTA - encerra o jogo
      escreval("  ", nome_jogador, " desmaiou...")
      escreval("  Voce foi derrotado. Game Over, Treinador!")
      escreval("")
      escreval("************************************************************")
      escreval("*                      GAME  OVER                          *")
      escreval("*          Treine mais e tente novamente!                  *")
      escreval("************************************************************")

   senao
      se (hp_inimigo <= 0) e (capturado = falso) entao
         // INIMIGO DERROTADO MAS NAO CAPTURADO - encerra
         escreval("  ", nome_inimigo, " desmaiou. Voce venceu!")
         escreval("")
         escreval("  Mas ", nome_inimigo, " nao foi capturado...")
         escreval("  Sem um novo companheiro, sua jornada termina por aqui.")
         escreval("")
         escreval("************************************************************")
         escreval("*     Capture Pokemon para continuar sua aventura!         *")
         escreval("************************************************************")

      senao
         // EEVEE CAPTURADO - continua para a evolucao e batalha 2

escreval("                       ##################%%%%%%%%%                     ")
escreval("                  ########################%%%%%%%%%%%%                 ")
escreval("             +*#############################%%%%%%%%%%%%%              ")
escreval("           **##################################%%%%%%%%%%%%%           ")
